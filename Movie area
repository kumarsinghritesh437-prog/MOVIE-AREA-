# ====== Config ======
API_ID = 20035684
API_HASH = "987a8b7ee93d55e76bb29fce4d8ebf52"
BOT_TOKEN = "8315587555:AAEB8hCCcXn_FN6SHWyUA_ZWuMWcZf6V8ts"

SHORTLINK_URL = "earnlinks.in"
